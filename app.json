{
  "expo": {
    "name": "MedSaga",
    "slug": "medsaga",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/MedSagaIcon.png",
    "scheme": "medsaga",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.medsaga.MedSaga",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/MedSagaIcon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/MedSagaIcon.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medsaga.MedSaga"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c4fb8c3-ac7b-43f2-8e5d-92b2ea388ccf"
      }
    }
  }
}
